-- Databases created before the excluded_scanlators switch (33.sqm) still have the old library_view,
-- which joins scanlators_view, and scanlators_view itself still selects the column dropped below, so
-- SQLite rejects the DROP COLUMN. Drop both and recreate library_view from the current definition.
DROP VIEW IF EXISTS library_view;
DROP VIEW IF EXISTS scanlators_view;

-- excluded_scanlators has been the source of truth since 33.sqm, and the old column was kept in sync
-- with it, so nothing is lost by dropping it.
ALTER TABLE mangas DROP COLUMN filtered_scanlators;

-- Release schedule of an entry: days between releases (negative when set by the user) and the
-- day of its next expected release in epoch milliseconds, 0 while unknown.
ALTER TABLE mangas ADD COLUMN fetch_interval INTEGER NOT NULL DEFAULT 0;
ALTER TABLE mangas ADD COLUMN next_update INTEGER NOT NULL DEFAULT 0;

CREATE VIEW library_view AS
SELECT
    M.*,
    coalesce(C.total, 0) AS total,
    coalesce(C.read_count, 0) AS has_read,
    coalesce(C.bookmark_count, 0) AS bookmark_count,
    coalesce(MC.category_id, 0) AS category,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.lastFetch, 0) AS lastFetch
FROM mangas AS M
LEFT JOIN (
    SELECT
        chapters.manga_id,
        count(*) AS total,
        sum(read) AS read_count,
        sum(bookmark) AS bookmark_count,
        coalesce(max(chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.history_last_read), 0) AS lastRead,
        coalesce(max(chapters.date_fetch), 0) AS lastFetch
    FROM chapters
    LEFT JOIN excluded_scanlators
    ON chapters.manga_id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    LEFT JOIN history
    ON chapters._id = history.history_chapter_id
    WHERE excluded_scanlators.scanlator IS NULL
    GROUP BY chapters.manga_id
) AS C
ON M._id = C.manga_id
LEFT JOIN (SELECT * FROM mangas_categories) AS MC
ON MC.manga_id = M._id
WHERE M.favorite = 1
ORDER BY M.title;
