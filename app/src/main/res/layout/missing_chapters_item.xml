<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/missing_chapters_divider_start"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:background="@color/material_on_background_disabled"
        app:layout_constraintBottom_toBottomOf="@id/missing_chapters_text"
        app:layout_constraintEnd_toStartOf="@id/missing_chapters_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/missing_chapters_text" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/missing_chapters_text"
        style="?textAppearanceLabelMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/material_on_background_disabled"
        tools:text="2 chapters missing"
        app:layout_constraintEnd_toStartOf="@id/missing_chapters_divider_end"
        app:layout_constraintStart_toEndOf="@id/missing_chapters_divider_start"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/missing_chapters_divider_end"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:background="@color/material_on_background_disabled"
        app:layout_constraintBottom_toBottomOf="@id/missing_chapters_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/missing_chapters_text"
        app:layout_constraintTop_toTopOf="@id/missing_chapters_text" />
</androidx.constraintlayout.widget.ConstraintLayout>
