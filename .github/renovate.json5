{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["Dependencies"],
  // Rokku enforces Conventional Commits (see CONTRIBUTING.md), unlike upstream
  // Mihon which disables this. Keep enabled so Renovate's commit messages
  // conform to the repo's commit convention.
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
    },
  ],
}
